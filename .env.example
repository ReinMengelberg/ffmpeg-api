# Copy to .env and fill in. Never commit .env.

# --- docker-compose ---
# Interpolated into API_KEY by docker-compose.yml. Coolify generates this
# automatically; set it yourself for local `docker compose up`.
# Generate one with: openssl rand -hex 32
SERVICE_PASSWORD_MP3=

# --- app.py (when running outside compose) ---
# Required X-API-Key header value. Leave empty to disable auth (open service).
API_KEY=
# Max upload size in bytes (default 2 GiB).
MAX_BYTES=2147483648
# ffmpeg timeout in seconds.
FFMPEG_TIMEOUT_S=1800
# Scratch directory for uploads/outputs (default: system temp dir).
TMP_DIR=/tmp
